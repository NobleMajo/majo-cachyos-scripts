// loaded by the OPENCODE_CONFIG env var
{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@0xsero/open-queue",
        "opencode-models-discovery@latest"
    ],
    "provider": {
        "cunet": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://ai.intern.coreunit.net/v1",
                "apiKey": "{env:CUNET_AI_KEY}",
                "headers": {
                    "Authorization": "Basic {env:CUNET_AI_BASIC_AUTH}",
                },
                "modelsDiscovery": {
                    "enabled": true
                },
            },
            "models": {
                "cunet/auto": {
                    "name": "cunet/auto"
                },
            },
        },
    },
    "enabled_providers": [
        "cunet",
    ],
    "disabled_providers": [],
    "compaction": {
        "auto": true,
        "prune": false,
        "reserved": 8000,
    },
    "share": "disabled",
    "autoupdate": true,
    "snapshot": true,
    "lsp": true,
    "default_agent": "plan",
    "agent": {
        "plan": {
            "description": "Planning only, asks to edit docs files, but always blocks source code changes.",
            "mode": "primary",
            "temperature": 0.4,
            "permission": {},
            "prompt": "You are used inside OpenCode in plan mode. Plan the implementation and follow the users prompt. If a prompt is unclear, check for a README.md or other Markdown or docs files. At this point your not allowed to edit the source code. Always use the mcp named `explorer-mcp` to get a project overview, get your opencode permissions, and follow the explorer-mcp's behaviour instructions."
        },
        "build": {
            "description": "Uses read-only permissiony by default, but is allowed to ask for write permissions.",
            "mode": "primary",
            "temperature": 0.2,
            "permission": {
                "edit": {
                    "*": "ask",
                    "*.js": "allow",
                    "*.mjs": "allow",
                    "*.cjs": "allow",
                    "*.jsx": "allow",
                    "*.ts": "allow",
                    "*.mts": "allow",
                    "*.cts": "allow",
                    "*.tsx": "allow",
                    "*.go": "allow",
                    "*.py": "allow",
                    "*.rs": "allow",
                    "*.java": "allow",
                    "*.c": "allow",
                    "*.cs": "allow",
                    "*.php": "allow",
                    "*.rb": "allow",
                    "*.swift": "allow",
                    "*.zig": "allow",
                    "*.vue": "allow",
                    "*.svelte": "allow",
                    "*.html": "allow",
                    "*.css": "allow",
                    "*.scss": "allow",
                    "*.sass": "allow",
                    "*.less": "allow",
                    "*.sql": "allow",
                    "*.sh": "allow",
                    "*.lua": "allow",
                },
                "write": {
                    "*": "ask",
                    "*.js": "allow",
                    "*.mjs": "allow",
                    "*.cjs": "allow",
                    "*.jsx": "allow",
                    "*.ts": "allow",
                    "*.mts": "allow",
                    "*.cts": "allow",
                    "*.tsx": "allow",
                    "*.go": "allow",
                    "*.py": "allow",
                    "*.rs": "allow",
                    "*.java": "allow",
                    "*.c": "allow",
                    "*.cs": "allow",
                    "*.php": "allow",
                    "*.rb": "allow",
                    "*.swift": "allow",
                    "*.zig": "allow",
                    "*.vue": "allow",
                    "*.svelte": "allow",
                    "*.html": "allow",
                    "*.css": "allow",
                    "*.scss": "allow",
                    "*.sass": "allow",
                    "*.less": "allow",
                    "*.sql": "allow",
                    "*.sh": "allow",
                    "*.lua": "allow",
                },
                "bash": {
                    "bun run *": "allow",
                    "npm run *": "allow",
                    "make *": "allow",
                    "git *--output*": "ask",
                    "git commit *": "ask",
                    "git rebase *": "ask",
                    "git merge *": "ask",
                    "curl *-o *": "ask",
                    "curl *--output*": "ask",
                    "*>*": "deny",
                    "*<*": "deny",
                    "*|*": "deny",
                    "*&*": "deny",
                    "*;*": "deny",
                    "*$(*)*": "deny",
                    "*`*": "deny",
                    "*\n*": "deny"
                }
            },
            "prompt": "You are used inside OpenCode in build mode. Implement requested features, refactor code, write unit tests, and execute build and shell tools to fulfill tasks. Always use the mcp named `explorer-mcp` to get a project overview, get your opencode permissions, and follow the explorer-mcp's behaviour instructions."
        },
    },
    "permission": {
        "*": "ask",
        "skill": {
            "caveman": "allow",
            "customize-opencode": "deny",
        },
        "explorer-mcp_*": "allow",
        "angular-docs_*": "allow",
        "bun-oven-docs_*": "allow",
        "npm-docs_*": "allow",
        "nodejs-docs_*": "allow",
        "package-manager-docs_*": "allow",
        "opencode-mirror-docs_*": "allow",
        "opencode-remote-docs_*": "allow",
        "golang-docs_*": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": {
            "~/ws/**": "allow",
            "./**": "allow",
        },
        "read": {
            "*": "allow",
            "*.env*": "deny",
            "*.netrc*": "deny",
            "*.npmrc*": "deny",
            "*.sample.env*": "allow",
            "*.sample.netrc*": "allow",
            "*.sample.npmrc*": "allow",
            "*.env.project": "allow",
        },
        "task": {
            "*": "allow",
        },
        "bash": {
            "*": "ask",
            "cargo *": "deny",
            "pip *": "deny",
            "pipreqs *": "deny",
            "helm *": "deny",
            "podman *": "deny",
            "pnpm *": "deny",
            "yarn *": "deny",
            "python *": "deny",
            "bun *": "deny",
            "node *": "deny",
            "bun x *": "ask",
            "bun run *": "ask",
            "npx *": "ask",
            "npm ls *": "allow",
            "npm audit *": "allow",
            "npm list *": "allow",
            "npm view *": "allow",
            "npm run *": "ask",
            "make *": "ask",
            "go *": "ask",
            "go build *": "deny",
            "go test *": "allow",
            "gofmt *": "allow",
            "docker *": "ask",
            "docker logs *": "allow",
            "docker ps *": "allow",
            "docker port *": "allow",
            "docker restart *": "deny",
            "docker pull *": "allow",
            "docker inspect *": "allow",
            "docker history *": "allow",
            "docker volume ls *": "allow",
            "docker volume inspect *": "allow",
            "docker network ls *": "allow",
            "docker network inspect *": "allow",
            "docker images *": "allow",
            "docker image ls *": "allow",
            "docker image inspect *": "allow",
            "docker top *": "allow",
            "docker --version *": "allow",
            "docker -v *": "allow",
            "docker-compose *": "ask",
            "docker-compose logs *": "allow",
            "docker-compose ps *": "allow",
            "docker-compose ls *": "allow",
            "docker-compose port *": "allow",
            "docker-compose pull *": "allow",
            "docker-compose restart *": "deny",
            "docker-compose stats *": "allow",
            "docker-compose version *": "allow",
            "docker-compose volumes *": "allow",
            "git branch *": "ask",
            "git branch": "allow",
            "git branch -a": "allow",
            "git branch -v *": "allow",
            "git rev-list *": "allow",
            "git remote *": "ask",
            "git remote": "allow",
            "git remote -v *": "allow",
            "git remote get-url *": "allow",
            "git status *": "allow",
            "git ls-files *": "allow",
            "git tree *": "allow",
            "git diff *": "allow",
            "git log *": "allow",
            "git grep *": "allow",
            "git stash list *": "allow",
            "git show *": "allow",
            "git history *": "allow",
            "git checkout HEAD *": "ask",
            "git *--output*": "deny",
            "git commit *": "deny",
            "git rebase *": "deny",
            "git merge *": "deny",
            "cat *": "allow",
            "find *": "allow",
            "find *-exec*": "deny",
            "find *-ok*": "deny",
            "find *-delete*": "deny",
            "find *-fprint*": "deny",
            "find *-fls*": "deny",
            "grep *": "allow",
            "rg *": "allow",
            "ps *": "allow",
            "ls *": "allow",
            "lsof *": "allow",
            "echo *": "allow",
            "true *": "allow",
            "sort -o *": "deny",
            "sort --output *": "deny",
            "sort --output=*": "deny",
            "sort *": "allow",
            "diff *": "allow",
            "head *": "allow",
            "sleep *": "allow",
            "tail *": "allow",
            "command *": "deny",
            "command -v *": "allow",
            "which *": "allow",
            "whereis *": "allow",
            "whoami *": "allow",
            "wc *": "allow",
            "file *": "allow",
            "stat *": "allow",
            "json_pp *": "allow",
            "jq *": "allow",
            "tar -tvf *": "allow",
            "tar *--delete*": "deny",
            "unzip -l *": "allow",
            "tree *": "allow",
            "uname *": "allow",
            "hostname *": "allow",
            "env *": "deny",
            "env": "allow",
            "printenv *": "deny",
            "printenv": "allow",
            "df *": "allow",
            "du *": "allow",
            "free *": "allow",
            "uptime *": "allow",
            "lscpu *": "allow",
            "sw_vers *": "allow",
            "curl *": "allow",
            "curl *-o *": "deny",
            "curl *--output*": "deny",
            "host *": "allow",
            "nslookup *": "allow",
            "ping -c *": "allow",
            "netstat *": "allow",
            "ss *": "allow",
            "dig *": "allow",
            "pwd *": "allow",
            "*>*": "deny",
            "*<*": "deny",
            "*|*": "deny",
            "*&*": "deny",
            "*;*": "deny",
            "*$(*)*": "deny",
            "*`*": "deny",
            "*\n*": "deny",
        },
        "edit": "deny",
        "write": "deny",
        "webfetch": "ask",
        "websearch": "ask",
    },
    "watcher": {
        "ignore": [
            "**/node_modules/**",
            "**/.git/**",
            "**/vendor/**",
            "**/dist/**",
            "**/tmp/**",
            "**/.store/**",
            "**/.tmp/**",
            "**/.cache/**",
            "**/.angular/**",
            "**/.terraform/**",
            "**/.terraform.lock.hcl",
            "**/package-lock.json",
            "**/bun.lockb",
            "**/bun.lock",
            "**/go.sum",
            "**/.out/**",
            "**/build/**",
        ],
    },
    "command": {
        "check": {
            "template": "Analyze the latest output generated by the AI agent. Validate all assertions, implementation paths, and structural assumptions by cross-referencing against local repository documentation, internal source code, active Model Context Protocol (MCP) servers, and official external web documentation. Highlight discrepancies, outdated API usage, or hallucinations. Be aware of your OpenCode permissions, and aim to use permitted commands wherever possible. Use the 'explorer-mcp'-mcp at first: it will provide you some of that informations compact, faster and directly.",
            "description": "Validates the reasoning and output of preceding agent operations against local source code, configuration files, MCP context, and external documentation.",
        },
        "audit": {
            "template": "Use the 'explorer-mcp'-mcp first: it will provide you some of that informations compact, faster and directly. Scan the entire codebase for typos, syntax, grammar, translation, and language inconsistencies or forgotten items, asking the user via the question tool for each finding with at least 3 proposed solutions.",
            "description": "Interactively audits the codebase for typos, grammar, syntax errors, and language inconsistencies with fix options.",
        },
        "review": {
            "template": "Scan the entire codebase for anti-patterns, inconsistent usage, code duplication, over-complexity, single-responsibility violations, and dead code, asking the user via the question tool for each finding with at least 3 proposed solutions.",
            "description": "Interactively reviews the codebase for anti-patterns, duplications, complexity, and dead code with fix options.",
        },
        "explore": {
            "template": "Use the 'explorer-mcp'-mcp first: it will provide you some of that informations compact, faster and directly. Follow the behavior instructions of the explorer-mcp tool response.",
            "description": "Performs a rapid, lightweight analysis of the codebase structure, multi-level dependencies, git history, and active runtime containers.",
        },
        "test": {
            "template": "Scan the workspace manifests to identify configured test runners, linters, static analysis tools, and code formatters. Execute these validation suites sequentially and capture all standard output and error streams. Concurrently, inspect local container configurations or running service instances to evaluate active runtime stability and extract error logs. Compile a comprehensive diagnostic overview containing exact failure snips, log paths, and execution context. Do not modify source code, configurations, or attempt auto-fixing behavior. Use the 'explorer-mcp'-mcp at first: it will provide you some of that informations compact, faster and directly.",
            "description": "Executes local test, lint, and formatting suites, inspects active container/service runtimes, and compiles a detailed diagnostic report of all failures and warnings without mutating code.",
        },
        "continue": {
            "template": "1. WARMUP: use the pwd command, call the `explorer-mcp`-mcp and use the todo tool (its not a mcp, not grep and its not on disk). Its the opencode `todo` tool. 2. WORK: start implementing the next open todo tasks of the plan. so go and start now. 3. REVIEW: afterwards give me breaking points to commit the changes inbetween. do one feature after eachother and after each todofeature give me 3 example commit messages to commit the at that point uncommited changes. use the `explorer-mcp`'s last commit messages to design the recommended commit messages.",
            "description": "Continue the planned todo tasks."
        },
        "commit": {
            "template": " At first, use the 'explorer-mcp'-mcp: it will provide you some of that informations compact, faster and directly. Follow the behavior instructions of the explorer-mcp tool response. Use this fresh `explorer-mcp` output and check what other git informations are missing and collect them in single commands. Group dirty changes into logical atomic commit separations. For each separation: list files, one-line logic summary, and exactly 3 lowercase-imperative commit message variants (scoped like recent git log; 3 = messages per separation, not number of separations). End with 'No changes found' or 'Should i commit the described commit messages without the descriptions?'",
            "description": "Analyzes the current Git diff to formulate precise, scoped commit message variations and awaits structural execution approval.",
        },
    },
    "formatter": {
        "prettier": {
            "disabled": true,
        },
        "custom-prettier": {
            "command": [
                "bun",
                "x",
                "prettier",
                "--write",
                "$FILE"
            ],
            "extensions": [
                ".js",
                ".ts",
                ".jsx",
                ".tsx",
                ".json"
            ],
        },
        "gofmt": {
            "command": [
                "gofmt",
                "-w",
                "$FILE"
            ],
            "extensions": [
                ".go"
            ],
        },
    },
    "mcp": {
        "explorer-mcp": {
            "type": "local",
            "enabled": true,
            "command": [
                "go",
                "run",
                "github.com/NobleMajo/explorer-mcp@latest",
                "-O",
                "-B",
                "-p",
                "3",
                "-c",
                "20",
                "-d",
                "8",
            ],
        },
        "angular-docs": {
            "type": "local",
            "enabled": true,
            "command": [
                "bun",
                "x",
                "@angular/cli",
                "mcp",
                "--read-only",
                "--local-only",
            ],
        },
        "bun-oven-docs": {
            "type": "local",
            "enabled": true,
            "command": [
                "bun",
                "x",
                "mcp-bun@latest"
            ],
        },
        // "npm-docs": {
        //     "type": "local",
        //     "enabled": false,
        //     "command": [
        //         "bun",
        //         "x",
        //         "@iflow-mcp/npm-package-docs-mcp"
        //     ],
        // },
        // "nodejs-docs": {
        //     "type": "local",
        //     "enabled": false,
        //     "command": [
        //         "bun",
        //         "x",
        //         "mcp-server-nodejs-api-docs"
        //     ],
        // },
        "package-manager-docs": {
            "type": "local",
            "enabled": true,
            "command": [
                "bun",
                "x",
                "@iflow-mcp/mcp-package-docs"
            ],
        },
        "opencode-docs": {
            "type": "local",
            "enabled": true,
            "command": [
                "bun",
                "x",
                "opencode-docs-mcp"
            ],
        },
        // "opencode-remote-docs": {
        //     "type": "remote",
        //     "enabled": false,
        //     "url": "https://tryinspector.com/api/opencode-docs/mcp",
        // },
        "golang-docs": {
            "type": "local",
            "enabled": true,
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "ghcr.io/mrjoshuak/godoc-mcp:latest",
            ],
        },
    },
}